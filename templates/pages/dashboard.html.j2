{% extends "layouts/base.html.j2" %}

{% block title %}Dashboard{% endblock title %}

{% block content %}
<h1 class="kanjo-page-title">Créer un nouveau journal</h1>

<form id="journal-form" class="kanjo-form">
  <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px">
    <div class="kanjo-form-group">
      <label for="date" class="kanjo-label">Date *</label>
      <input type="date" id="date" name="date" class="kanjo-input" required>
      <small class="kanjo-help-text">Vous ne pouvez pas créer un journal dans le futur</small>
    </div>

    <div class="kanjo-form-group">
      <label for="emotion" class="kanjo-label">Comment vous sentez-vous ? *</label>
      <select id="emotion" name="emotion" class="kanjo-input" required>
        <option value="">Sélectionnez une émotion</option>
        <option value="Happy">😊 Heureux</option>
        <option value="Sad">😢 Triste</option>
        <option value="Angry">😠 En colère</option>
        <option value="Surprised">😲 Surpris</option>
        <option value="Disappointed">😞 Déçu</option>
        <option value="Anxious">😰 Anxieux</option>
        <option value="Calm">😌 Calme</option>
        <option value="Excited">🤩 Excité</option>
        <option value="Bored">😑 Ennuyé</option>
      </select>
    </div>
  </div>

  <div class="kanjo-form-group">
    <label for="content" class="kanjo-label">Contenu *</label>
    <textarea id="content" name="content" class="kanjo-textarea" rows="12" required
      placeholder="Écrivez votre journal ici... Vous pouvez utiliser le format Markdown."></textarea>
    <small class="kanjo-help-text">Supporte le format Markdown (# titre, **gras**, *italique*, etc.)</small>
  </div>

  <div class="kanjo-form-group">
    <label class="kanjo-checkbox-label">
      <input type="checkbox" id="readonly" name="readonly" class="kanjo-checkbox">
      <span>Marquer comme lecture seule</span>
    </label>
    <small class="kanjo-help-text">Une fois en lecture seule, vous ne pourrez plus modifier ce journal</small>
  </div>

  <div class="kanjo-form-actions">
    <button type="submit" class="kanjo-btn kanjo-btn-primary">
      <span class="kanjo-btn-text">Enregistrer le journal</span>
    </button>
    <button type="button" class="kanjo-btn kanjo-btn-secondary" onclick="document.getElementById('journal-form').reset()">
      Réinitialiser
    </button>
  </div>
</form>
<div id="message-container"></div>


<script>
  // Initialiser le formulaire avec la date d'aujourd'hui
  document.getElementById('date').valueAsDate = new Date();
  document.getElementById('date').max = new Date().toISOString().split('T')[0];

  // Gérer la soumission du formulaire
  document.getElementById('journal-form').addEventListener('submit', async (e) => {
    e.preventDefault();

    const formData = new FormData(e.target);
    const date = formData.get('date');
    const emotion = formData.get('emotion');
    const content = formData.get('content');
    const readonly = formData.get('readonly') === 'on';

    try {
      const result = await createJournal(date, emotion, content, readonly);
      showMessage('Journal créé avec succès ! Redirection...', 'success');
      
      // Rediriger vers le journal créé
      setTimeout(() => {
        location.href = `/journals/${date}`;
      }, 1000);
    } catch (error) {
      showMessage(error.message || 'Erreur lors de la création du journal', 'error');
    }
  });

  function showMessage(message, type) {
    const container = document.getElementById('message-container');
    const messageDiv = document.createElement('div');
    messageDiv.className = `kanjo-message kanjo-message-${type}`;
    messageDiv.textContent = message;
    container.innerHTML = '';
    container.appendChild(messageDiv);

    setTimeout(() => {
      messageDiv.remove();
    }, 5000);
  }
</script>
{% endblock content %}