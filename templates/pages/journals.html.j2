{% extends "layouts/base.html.j2" %}

{% block title %}Mes Journaux{% endblock title %}

{% block content %}
  <div class="kanjo-header">
    <h1 class="kanjo-page-title">Mes Journaux</h1>
    <button onclick="window.location.reload()" class="kanjo-btn kanjo-btn-secondary">
      <span class="material-symbols-outlined">refresh</span> Actualiser
    </button>
  </div>

  <div id="journals-container" class="kanjo-journals-grid">
    {% if journals|length == 0 %}
      <div class="kanjo-empty">Aucun journal trouvé. Créez votre premier journal !</div>
    {% else %}
      {% for journal in journals %}
        {% set emotion_data = {
          'Happy': {'emoji': '😊', 'name': 'Heureux'},
          'Sad': {'emoji': '😢', 'name': 'Triste'},
          'Angry': {'emoji': '😠', 'name': 'En colère'},
          'Surprised': {'emoji': '😲', 'name': 'Surpris'},
          'Disappointed': {'emoji': '😞', 'name': 'Déçu'},
          'Anxious': {'emoji': '😰', 'name': 'Anxieux'},
          'Calm': {'emoji': '😌', 'name': 'Calme'},
          'Excited': {'emoji': '🤩', 'name': 'Excité'},
          'Bored': {'emoji': '😑', 'name': 'Ennuyé'}
        } %}
        {% set emotion = emotion_data[journal.emotion] %}
        
        {% if journal.readonly %}
          <div class="kanjo-journal-card kanjo-readonly">
            <div class="kanjo-journal-header">
              <div class="kanjo-journal-emotion">{{ emotion.emoji }}</div>
              <div class="kanjo-journal-date">
                {{ journal.date }}
              </div>
              <span class="kanjo-badge"><span class="material-symbols-outlined">lock</span> Lecture seule</span>
            </div>
            <div class="kanjo-journal-actions">
              <button onclick="viewJournal('{{ journal.date }}')" class="kanjo-btn kanjo-btn-small">
                <span class="material-symbols-outlined">visibility</span> Voir
              </button>
              <button onclick="deleteJournal('{{ journal.date }}')" class="kanjo-btn kanjo-btn-small kanjo-btn-danger">
                <span class="material-symbols-outlined">delete</span> Supprimer
              </button>
            </div>
          </div>
        {% else %}
          <div class="kanjo-journal-card">
            <div class="kanjo-journal-header">
              <div class="kanjo-journal-emotion">{{ emotion.emoji }}</div>
              <div class="kanjo-journal-date">
                {{ journal.date }}
              </div>
            </div>
            <div class="kanjo-journal-actions">
            <button onclick="viewJournal('{{ journal.date }}')" class="kanjo-btn kanjo-btn-small">
              <span class="material-symbols-outlined">visibility</span> Voir
            </button>
            <button onclick="editJournal('{{ journal.date }}')" class="kanjo-btn kanjo-btn-small kanjo-btn-primary">
              <span class="material-symbols-outlined">edit</span> Éditer
            </button>
            <button onclick="deleteJournal('{{ journal.date }}')" class="kanjo-btn kanjo-btn-small kanjo-btn-danger">
              <span class="material-symbols-outlined">delete</span> Supprimer
            </button>
          </div>
        </div>
        {% endif %}
      {% endfor %}
    {% endif %}
  </div>

  <div id="message-container"></div>

<script>
  function viewJournal(date) {
    location.href = `/journals/${date}`;
  }

  function editJournal(date) {
    location.href = `/journals/${date}/edit`;
  }

  function closeEditModal() {
    document.getElementById('edit-modal').style.display = 'none';
  }

  document.getElementById('edit-form').addEventListener('submit', async (e) => {
    e.preventDefault();
    
    const date = document.getElementById('edit-date').value;
    const emotion = document.getElementById('edit-emotion').value;
    const content = document.getElementById('edit-content').value;
    const readonly = document.getElementById('edit-readonly').checked;

    try {
      await updateJournal(date, emotion, content, readonly);
      showMessage('Journal mis à jour avec succès !', 'success');
      closeEditModal();
      location.reload(); // Recharger la page pour afficher les changements
    } catch (error) {
      showMessage(error.message || 'Erreur lors de la mise à jour du journal', 'error');
    }
  });

  async function deleteJournal(date) {
    if (!confirm('Êtes-vous sûr de vouloir supprimer ce journal ? Cette action est irréversible.')) {
      return;
    }

    try {
      await removeJournal(date);
      showMessage('Journal supprimé avec succès', 'success');
      setTimeout(() => location.reload(), 1000); // Recharger après 1 seconde
    } catch (error) {
      showMessage('Erreur lors de la suppression du journal', 'error');
    }
  }

  function showMessage(message, type) {
    const container = document.getElementById('message-container');
    const messageDiv = document.createElement('div');
    messageDiv.className = `kanjo-message kanjo-message-${type}`;
    messageDiv.textContent = message;
    container.innerHTML = '';
    container.appendChild(messageDiv);
    
    setTimeout(() => {
      messageDiv.remove();
    }, 5000);
  }
</script>
{% endblock content %}